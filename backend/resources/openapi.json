{
  "openapi": "3.0.3",
  "info": {
    "title": "MOVIC API",
    "version": "1.0.0",
    "description": "Documentação interativa da API do MOVIC."
  },
  "servers": [
    { "url": "http://localhost:8000/api" }
  ],
  "tags": [
    { "name": "Auth", "description": "Cadastro, login e sessão." },
    { "name": "Profile", "description": "Perfil do usuário autenticado." },
    { "name": "Teacher", "description": "Recursos do professor." },
    { "name": "Student", "description": "Recursos do aluno." }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AuthRegister": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" },
          "role": { "type": "string", "enum": ["teacher", "student"] }
        },
        "required": ["name", "email", "password", "role"]
      },
      "AuthLogin": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        },
        "required": ["email", "password"]
      },
      "InviteStudent": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "format": "email" }
        },
        "required": ["email"]
      },
      "StatusUpdate": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "trial", "pending_payment", "inactive"]
          }
        },
        "required": ["status"]
      },
      "ExerciseCreate": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "video_url": { "type": "string" }
        },
        "required": ["name"]
      },
      "PlanCreate": {
        "type": "object",
        "properties": {
          "title": { "type": "string" }
        },
        "required": ["title"]
      },
      "WorkoutDayCreate": {
        "type": "object",
        "properties": {
          "weekday": { "type": "integer", "minimum": 0, "maximum": 6 },
          "title": { "type": "string" }
        },
        "required": ["weekday", "title"]
      },
      "WorkoutItemCreate": {
        "type": "object",
        "properties": {
          "exercise_id": { "type": "integer" },
          "sets": { "type": "integer" },
          "reps": { "type": "string" },
          "rest_seconds": { "type": "integer" }
        },
        "required": ["exercise_id", "sets", "reps"]
      },
      "PaymentRegister": {
        "type": "object",
        "properties": {
          "student_id": { "type": "integer" },
          "amount_cents": { "type": "integer" },
          "method": { "type": "string", "enum": ["pix", "card", "cash"] },
          "description": { "type": "string" },
          "transaction_id": { "type": "string" }
        },
        "required": ["student_id", "amount_cents", "method"]
      },
      "ManualPayment": {
        "type": "object",
        "properties": {
          "plan_id": { "type": "integer" },
          "amount_cents": { "type": "integer" },
          "method": { "type": "string", "enum": ["pix", "card", "cash"] }
        },
        "required": ["plan_id", "amount_cents", "method"]
      },
      "SessionStart": {
        "type": "object",
        "properties": {
          "workout_day_id": { "type": "integer" }
        },
        "required": ["workout_day_id"]
      },
      "SessionCheck": {
        "type": "object",
        "properties": {
          "workout_item_id": { "type": "integer" },
          "is_checked": { "type": "boolean" }
        },
        "required": ["workout_item_id", "is_checked"]
      }
    }
  },
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Registrar usuário",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthRegister" } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AuthLogin" } } }
        },
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Logout",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/me": {
      "get": {
        "summary": "Dados do usuário autenticado",
        "tags": ["Auth"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/user/profile": {
      "patch": {
        "summary": "Atualizar perfil",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/user/password": {
      "patch": {
        "summary": "Atualizar senha",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/user/avatar": {
      "post": {
        "summary": "Enviar avatar",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/me/profile": {
      "patch": {
        "summary": "Alias atualizar perfil",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/me/password": {
      "patch": {
        "summary": "Alias atualizar senha",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/me/avatar": {
      "post": {
        "summary": "Alias enviar avatar",
        "tags": ["Profile"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/teacher/dashboard": {
      "get": {
        "summary": "Dashboard do professor",
        "tags": ["Teacher"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/teacher/requests": {
      "get": {
        "summary": "Listar solicitações de alunos",
        "tags": ["Teacher"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/teacher/requests/{studentId}/approve": {
